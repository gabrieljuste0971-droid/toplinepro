{
  "source": {
    "url": "https://construction-visuvate.framer.website/",
    "siteName": "Ironwood — Custom Home Builders & Design-Build",
    "platform": "Framer",
    "extractedAt": "2026-08-27",
    "method": "npx extract-design-system (dembrandt) + headless Chromium computed-style and WAAPI capture",
    "viewport": "1440x1000",
    "coverage": "single page (home) only"
  },
  "color": {
    "ink": "#171614",
    "inkDeep": "#1c1a17",
    "inkFooter": "#181614",
    "accent": "#f7b74a",
    "accentSoft": "#f0ce96",
    "bone": "#f5f3ee",
    "white": "#ffffff",
    "textBody": "#54504a",
    "textMuted": "#a8a298",
    "border": "#d8d2ca",
    "glass": "rgba(255,255,255,0.20)",
    "scrim": "linear-gradient(90deg, rgba(255,255,255,0.30) 0%, rgba(0,0,0,0.50) 100%)"
  },
  "typography": {
    "displayFont": "Cabinet Grotesk",
    "bodyFont": "Geist",
    "inputFont": "Plus Jakarta Sans",
    "styles": {
      "h1":      { "font": "display", "size": "72px", "weight": 800, "lineHeight": 1.2, "letterSpacing": "-0.02em", "transform": "uppercase" },
      "h2":      { "font": "display", "size": "54px", "weight": 700, "lineHeight": 1.2, "letterSpacing": "-0.02em", "transform": "uppercase" },
      "h3":      { "font": "display", "size": "36px", "weight": 700, "lineHeight": 1.3, "letterSpacing": "-0.04em" },
      "h4":      { "font": "display", "size": "24px", "weight": 700, "lineHeight": 1.0 },
      "h5":      { "font": "display", "size": "20px", "weight": 500, "lineHeight": 1.5 },
      "lead":    { "font": "body",    "size": "24px", "weight": 400, "lineHeight": 1.4, "letterSpacing": "-0.01em" },
      "bodyLg":  { "font": "body",    "size": "18px", "weight": 400, "lineHeight": 1.5 },
      "body":    { "font": "body",    "size": "16px", "weight": 500, "lineHeight": 1.5 },
      "bodySm":  { "font": "body",    "size": "14px", "weight": 400, "lineHeight": 1.5 },
      "caption": { "font": "body",    "size": "14px", "weight": 500, "lineHeight": 1.5 }
    }
  },
  "spacing": {
    "base": "8px",
    "scale": ["4px","8px","12px","16px","20px","24px","32px","48px","52px","56px","60px","80px","120px","160px"],
    "sectionPadding": "120px 0 160px",
    "sectionPaddingShort": "80px 0 160px",
    "sectionGap": "56px",
    "headerGap": "48px"
  },
  "layout": {
    "container": "1340px",
    "containerMax": "1600px",
    "measure": "860px",
    "secondaryColumn": "938px",
    "gutter": "50px",
    "gridOverlay": { "columns": 6, "pitch": "223px", "lineWidth": "1px", "lineColor": "#d8d2ca" },
    "breakpoints": ["810px", "1200px"]
  },
  "radius": {
    "xs": "2px",
    "default": "4px",
    "dot": "10px",
    "full": "999px",
    "note": "4px covers buttons, cards, images, chips, inputs and the nav pill. There is effectively one radius on this site."
  },
  "shadow": {
    "none": "none",
    "sm": "0 2px 4px rgba(0,0,0,0.15)",
    "lift": "0 0.6px 1.57px -1.5px rgba(0,0,0,0.17), 0 2.29px 5.95px -3px rgba(0,0,0,0.14), 0 10px 26px -4.5px rgba(0,0,0,0.02)",
    "note": "Shadows are near-absent. Depth is built from flat colour blocks and photography."
  },
  "effects": {
    "backdropBlur": "4px",
    "revealBlur": "8px"
  },
  "motion": {
    "easing": {
      "reveal": "cubic-bezier(0.12, 0.23, 0.5, 1)",
      "standard": "cubic-bezier(0.4, 0, 0.2, 1)",
      "glide": "cubic-bezier(0.25, 0.1, 0.25, 1)"
    },
    "duration": {
      "fast": "150ms",
      "quick": "200ms",
      "base": "250ms",
      "mid": "300ms",
      "reveal": "400ms",
      "glide": "400ms"
    },
    "stagger": "75ms",
    "enterDelay": "400ms",
    "patterns": {
      "headlineWordReveal": {
        "target": "each word wrapped in an inline-block span",
        "keyframes": { "opacity": [0.001, 1], "filter": ["blur(8px)", "blur(0px)"] },
        "duration": "400ms",
        "easing": "cubic-bezier(0.12, 0.23, 0.5, 1)",
        "fill": "both",
        "delays": ["400ms", "475ms", "550ms", "625ms", "700ms", "775ms", "850ms", "925ms"]
      },
      "scrollReveal": [
        { "name": "rise-lg",   "from": "opacity:0; transform: translateY(30px) scale(0.8)" },
        { "name": "rise-md",   "from": "opacity:0; transform: translateY(10px) scale(0.9)" },
        { "name": "rise-sm",   "from": "opacity:0; transform: translateY(8px) scale(0.9)" },
        { "name": "rise-left", "from": "opacity:0; transform: translateX(-24px) translateY(30px) scale(0.9)" }
      ],
      "hover": [
        { "target": "trailing arrow icon in any CTA", "change": "transform: rotate(45deg)" },
        { "target": "nav CTA", "change": "opacity: 1 -> 0.8" }
      ]
    }
  },
  "components": {
    "button": {
      "radius": "4px",
      "border": "none",
      "shadow": "none",
      "heights": { "default": "44px", "small": "40px" },
      "padding": { "default": "8px 20px", "withTrailingIcon": "6px 6px 6px 12px" },
      "gap": "12px",
      "iconChip": { "size": "32px", "radius": "4px" },
      "variants": {
        "primary": { "background": "#f7b74a", "color": "#171614" },
        "dark":    { "background": "#171614", "color": "#ffffff" },
        "light":   { "background": "#ffffff", "color": "#171614" }
      }
    },
    "iconButton": { "size": "40px", "radius": "4px", "variants": ["#f7b74a", "#171614"], "disabled": "#f0ce96" },
    "badge": { "background": "#f7b74a", "color": "#171614", "radius": "4px", "transform": "uppercase", "leadingDot": true },
    "chip": { "background": "#f5f3ee", "color": "#171614", "radius": "4px", "padding": "6px 8px", "height": "30px" },
    "card": { "radius": "4px", "border": "none", "shadow": "none", "structure": "image + title + body, no container box" },
    "navbar": { "height": "73px", "inset": "20px", "radius": "4px", "transparentOverHero": true, "scrolledBackground": "#171614" },
    "carouselDot": { "inactive": "10px circle", "active": "28px x 10px pill", "radius": "10px" },
    "input": { "height": "41px", "padding": "12px", "radius": "4px", "background": "rgba(255,255,255,0.20)", "border": "none" },
    "footer": { "background": "#181614", "color": "#ffffff" }
  },
  "caveats": [
    "Home page only — other routes were not visited.",
    "Framer Motion drives the animations in JS; the CSS keyframes here are reconstructions of the captured WAAPI options, not copies of site CSS.",
    "Framer strips semantic class names, so button padding on the outer <a> reads 0px; the values above come from the painted inner element.",
    "Cabinet Grotesk (Fontshare) and Geist (Vercel) are third-party fonts — check licensing before shipping.",
    "Colours were read from Framer's --token-* custom properties, which is the site's real palette, not a sampled approximation."
  ]
}
