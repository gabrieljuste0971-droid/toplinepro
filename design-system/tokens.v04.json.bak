{
  "$schema": "https://design-tokens.org/draft",
  "name": "Seam & Slate",
  "version": "0.4.0",
  "brand": "TopLine Pro Construction",
  "provenance": {
    "color": "nossa — amostrada do logotipo",
    "theme": "nosso — claro, unico",
    "atmosphere": "nossa — wash, grao, costura",
    "typography": "Ironwood — Cabinet Grotesk + Geist",
    "shape": "Ironwood — raio unico 4px, sem sombra",
    "controls": "Ironwood — 44/40px, chip 32px, hover por opacidade",
    "rhythm": "Ironwood — secao 120/160, container 1340",
    "motion": "Ironwood — 400ms, cubic-bezier(.12,.23,.5,1), blur 8px",
    "reference": "ironwood-ref/ (namespaced --ref-*)"
  },
  "theme": {
    "mode": "light-only",
    "followsSystemPreference": false,
    "why": "Briefing marcou 'Cores Claras' e deixou 'Cores Escuras' desmarcada."
  },
  "primitive": {
    "color": {
      "blue": {
        "50": "#F2F8FD",
        "100": "#DCEDF9",
        "200": "#BCDCF3",
        "300": "#9BCBEE",
        "400": "#7BBDEC",
        "500": "#5A9BCE",
        "600": "#3F7CAC",
        "700": "#2F6088",
        "800": "#254A6A",
        "900": "#16324A"
      },
      "silver": {
        "50": "#FAFBFC",
        "100": "#F1F4F7",
        "200": "#E4E9ED",
        "300": "#CFD5DA",
        "400": "#B2BAC1",
        "500": "#8E979F",
        "600": "#62707B",
        "700": "#44525E",
        "800": "#31373C",
        "900": "#101922"
      },
      "copper": {
        "600": "#9A5F32"
      },
      "green": {
        "50": "#ECF6F1",
        "600": "#2E7D5B"
      },
      "amber": {
        "50": "#FDF5E7",
        "600": "#A8710F"
      },
      "red": {
        "50": "#FBEDED",
        "600": "#B23B3B"
      },
      "white": "#FFFFFF",
      "anchors": {
        "400": "topo do degrade do logotipo",
        "600": "meio",
        "800": "base"
      }
    },
    "gradient": {
      "brand": "linear-gradient(160deg, #7BBDEC 0%, #254A6A 100%)",
      "metal": "linear-gradient(160deg, #FFFFFF 0%, #DDE2E6 38%, #9BA3AA 62%, #EDF0F2 100%)"
    },
    "atmosphere": {
      "wash": "radial-gradient(120% 78% at 50% -12%, rgba(123,189,236,.16) 0%, rgba(123,189,236,0) 62%)",
      "seam": "repeating-linear-gradient(90deg, rgba(37,74,106,.055) 0 1px, transparent 1px 32px)",
      "grainOpacity": 0.032
    },
    "font": {
      "display": "\"Cabinet Grotesk\", \"Archivo\", \"Helvetica Neue\", Arial, sans-serif",
      "body": "\"Geist\", \"Helvetica Neue\", Arial, sans-serif",
      "mono": "\"IBM Plex Mono\", ui-monospace, monospace",
      "widthDisplay": 96,
      "note": "Cabinet Grotesk e Fontshare; sob CSP restrita ao Google Fonts ela cai para Archivo em wdth 96."
    },
    "fontSize": {
      "h1": "72px",
      "h2": "54px",
      "h3": "36px",
      "h4": "24px",
      "lead": "24px",
      "h5": "20px",
      "lg": "18px",
      "md": "17px",
      "sm": "14px",
      "xs": "12px"
    },
    "lineHeight": {
      "tight": 1.0,
      "display": 1.2,
      "heading": 1.3,
      "lead": 1.4,
      "body": 1.5
    },
    "letterSpacing": {
      "display": "-0.02em",
      "h3": "-0.04em",
      "lead": "-0.01em",
      "badge": "0.04em",
      "normal": "0"
    },
    "fontWeight": {
      "display": 800,
      "bold": 700,
      "medium": 500,
      "regular": 400
    },
    "caseDisplay": "uppercase",
    "space": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "12": "48px",
      "14": "56px",
      "20": "80px",
      "30": "120px",
      "40": "160px"
    },
    "layout": {
      "container": "1340px",
      "containerMax": "1600px",
      "measure": "860px",
      "gutter": "50px",
      "gridColumns": 6,
      "gridPitch": "223px",
      "gridLine": "1px",
      "sectionPad": "120px 0 160px",
      "sectionPadSm": "80px 0 160px"
    },
    "breakpoint": {
      "sm": "810px",
      "md": "1200px"
    },
    "radius": {
      "xs": "2px",
      "default": "4px",
      "dot": "10px",
      "full": "999px",
      "note": "4px em botao, card, imagem, chip, input, nav. Sem excecao."
    },
    "shadow": {
      "none": "none",
      "sm": "0 2px 4px rgba(22,50,74,.15)",
      "lift": "0 .6px 1.57px -1.5px rgba(22,50,74,.17), 0 2.29px 5.95px -3px rgba(22,50,74,.14), 0 10px 26px -4.5px rgba(22,50,74,.02)",
      "note": "Profundidade vem de bloco de cor e filete de 1px, nao de sombra."
    },
    "control": {
      "h": "44px",
      "hSm": "40px",
      "pad": "8px 20px",
      "padIcon": "6px 6px 6px 12px",
      "gap": "12px",
      "iconChip": "32px",
      "icon": "24px",
      "navH": "73px",
      "navInset": "20px",
      "inputH": "41px"
    },
    "easing": {
      "reveal": "cubic-bezier(.12,.23,.5,1)",
      "standard": "cubic-bezier(.4,0,.2,1)",
      "glide": "cubic-bezier(.25,.1,.25,1)"
    },
    "duration": {
      "fast": "150ms",
      "quick": "200ms",
      "base": "250ms",
      "mid": "300ms",
      "reveal": "400ms"
    },
    "sequence": {
      "stagger": "75ms",
      "delayEnter": "400ms",
      "blurEnter": "8px",
      "note": "Reveal palavra a palavra roda uma vez, na carga."
    }
  },
  "semantic": {
    "surface": {
      "page": "{color.white}",
      "alt": "{color.silver.100}",
      "raised": "{color.white}",
      "brand": "{color.blue.50}",
      "invert": "{color.blue.900}",
      "invertExceptions": [
        "placa de jardim de inverno",
        "colete de inverno da equipe"
      ]
    },
    "text": {
      "primary": "{color.silver.900}",
      "body": "{color.silver.700}",
      "muted": "{color.silver.600}",
      "onDark": "{color.white}"
    },
    "line": "#DDE4EA",
    "action": {
      "block": "{color.blue.400}",
      "onBlock": "{color.blue.900}",
      "dark": "{color.blue.900}",
      "onDark": "{color.white}",
      "light": "{color.white}",
      "onLight": "{color.blue.900}",
      "soft": "{color.blue.200}",
      "urgent": "{color.copper.600}"
    },
    "link": {
      "color": "currentColor",
      "decoration": "underline",
      "offset": "3px",
      "note": "Link nunca e colorido."
    },
    "focus": {
      "ring": "2px solid {color.blue.400}",
      "offset": "2px"
    },
    "dominance": {
      "surface": "80%",
      "navy": "12%",
      "sky": "8%",
      "navyRole": "tinta e filete, nunca superficie de secao",
      "note": "Medir por area ocupada."
    },
    "feedback": {
      "successFg": "{color.green.600}",
      "successBg": "{color.green.50}",
      "warningFg": "{color.amber.600}",
      "warningBg": "{color.amber.50}",
      "dangerFg": "{color.red.600}",
      "dangerBg": "{color.red.50}",
      "infoFg": "{color.blue.700}",
      "infoBg": "{color.blue.50}"
    }
  },
  "contrast": {
    "silver900_on_white": 17.73,
    "silver700_on_white": 8.03,
    "silver600_on_white": 5.09,
    "silver600_on_silver100": 4.61,
    "blue900_on_white": 13.21,
    "blue900_on_blue400": 6.5,
    "blue700_on_white": 6.67,
    "copper600_on_white": 5.18,
    "blue400_on_white": 2.03,
    "note": "blue-400 (#7BBDEC) reprova para texto sobre branco. So bloco, filete e foco."
  }
}