{
  "$schema": "https://design-tokens.org/draft",
  "name": "Seam & Slate",
  "version": "1.6.0",
  "brand": "TopLine Pro Construction",
  "provenance": {
    "color": "nossa — amostrada do logotipo, intocada desde a v0.1",
    "theme": "nosso — claro nas secoes; escuro so em moldura de midia",
    "atmosphere": "nossa — wash, grao, costura",
    "display": "Nossa — Inter 500, caixa alta",
    "text": "Nossa — Inter em todos os papeis, incluindo dado",
    "shape": "Habitate — escala 999 / 28 / 24 / 20 / 12",
    "controls": "Habitate — pill de 52px com chip circular de 40px",
    "glass": "Habitate — backdrop-filter em nav, painel e formulario",
    "rhythm": "Habitate — container 1400, gutter 64, secao 120/128",
    "motion": "Habitate — 900ms em cubic-bezier(.22,1,.36,1), cascata de 62ms",
    "reference": "ironwood-ref/ (namespaced --ref-*); habitate: geometria e movimento",
    "nav": "Bouncy Nav Pill — pill flutuante com pastilha que persegue o item sob o cursor"
  },
  "changedFrom_0_4": [
    "Raio unico de 4px aposentado. Entrou escala de cinco raios.",
    "Corpo saiu da Geist para a Manrope, com tracking de 0.02em.",
    "Existe superficie escura: a moldura de midia. Herói, formulario e CTA final.",
    "Botao virou pill de 52px com chip circular; padding assimetrico.",
    "Container 1340 -> 1400, gutter 50 -> 64, secao 120/160 -> 120/128.",
    "Reveal de 400ms passou a 900ms; a curva assinatura virou cubic-bezier(.22,1,.36,1).",
    "Escala de titulo virou fluida com clamp().",
    "v0.5.1: nav na geometria da Visuvate, token --r-nav de 4px e tema escuro opcional por botao.",
    "v0.6: tipografia inteira migrada para Inter, escala fechada em clamp(), pesos 400/500/600, medidas de linha em token.",
    "v0.7: nav na geometria da Habitate — barra escura de largura total com painel claro centralizado e filete concavo por mascara.",
    "v0.8: nav virou pill flutuante do Bouncy Nav Pill, com pastilha em mola cubic-bezier(.34,1.56,.64,1).",
    "v0.8.2: largura do pill amarrada ao container do conteudo; logotipo de 28 para 40px.",
    "v0.9: IBM Plex Mono removida, Inter em todos os papeis; barra de numeros do heroi sem caixa, filete ou vidro.",
    "v1.0: blur progressivo no topo ao rolar e inversao da navegacao por tom de secao.",
    "v1.1: cursor com rastro em canvas, portado do Cursor Dot Trail.",
    "v1.2: grade editorial no lugar dos tres cards da secao da diferenca; bloco de fechamento de navy para azul-claro.",
    "v1.3: contagem dos numeros do heroi com easeOutExpo e barra reespacada.",
    "v1.6: servicos viraram baralho de cards sobrepostos, no modelo Card Carousel."
  ],
  "theme": {
    "mode": "light-first",
    "followsSystemPreference": false,
    "darkAllowedIn": [
      "moldura de midia do heroi",
      "painel do formulario",
      "moldura do CTA final"
    ],
    "why": "Briefing marcou 'Cores Claras'. O escuro entra so como moldura de foto, nunca como fundo chapado de secao de texto.",
    "darkOptIn": {
      "attribute": "data-theme=\"dark\"",
      "storage": "localStorage tlp-theme",
      "trigger": "botao role=switch na navegacao",
      "prefersColorScheme": false,
      "why": "Preferencia explicita do visitante. O padrao continua claro, como o briefing pediu."
    }
  },
